# GRIFTERS environment configuration
# Contract address — leave empty until deployed (mint stays gated)
NEXT_PUBLIC_GRIFTERS_CONTRACT=
# Robinhood Chain testnet (official values from docs.robinhood.com/chain/connecting)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_SITE_URL=
# Server-side only — asset generation script (never exposed to the browser)
OPENAI_API_KEY=
# Whitelist storage (configure at least one in production)
# Supabase (primary) — server-side only, never NEXT_PUBLIC
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
WHITELIST_WEBHOOK_URL=
